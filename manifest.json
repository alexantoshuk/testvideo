{
  "name": "testvideo",
  "version": "0.3.0",
  "description": "Synthetic A/V sync plates: burn-in timecode/frame/meta, soft ticks @0.5s and loud @2s with matching flashes. Expand fps[] \u00d7 variants[] \u2192 clip id `{avc|hevc}_1080p_{fpsId}_{variantId}` (PCM MOV variants may limit fps via fpsIds; asset ext follows container).",
  "baseUrlHint": "https://github.com/alexantoshuk/testvideo/releases/download/v0.3.0",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "template": {
    "durationSec": 60.0,
    "softTickSec": 0.5,
    "loudTickSec": 2.0,
    "audio": {
      "codec": "aac",
      "channels": 1,
      "sampleRate": 48000,
      "pattern": {
        "softTickSec": 0.5,
        "loudTickSec": 2.0,
        "alignedAt": 0.0
      },
      "notes": "Default for AAC plates. Variants may override with audio / audioChannels / fpsIds (see mov_pcm24_gop12_bf0)."
    },
    "burnIn": [
      "timecode (pts hms)",
      "presentation frame index",
      "fps label",
      "encode metadata",
      "tick flash (soft bar + loud wash + corner pulse)"
    ]
  },
